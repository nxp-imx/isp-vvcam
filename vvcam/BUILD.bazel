#
# Bazel build configuration for Verisilicon ISP VVCAM drivers
# Converted from original Makefiles in v4l2/ directory
#
# Modules built:
#   - vvcam-dwe.ko     (Dewarp Engine)
#   - vvcam-isp.ko     (ISP core)
#   - vvcam-video.ko   (V4L2 video device)
#   - os08a20.ko       (OS08A20 sensor driver)
#   - basler-camera-driver-vvcam.ko (Basler camera proxy)
#
# Usage:
#   For imx8mp: //verisilicon_sw_isp_vvcam/vvcam:vvcam_modules_imx8mp
#   For imx:    //verisilicon_sw_isp_vvcam/vvcam:vvcam_modules_imx
#   Default:    //verisilicon_sw_isp_vvcam/vvcam:vvcam_modules (alias to imx8mp)

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load(":vvcam.bzl", "define_vvcam")

package(default_visibility = ["//visibility:public"])

# =============================================================================
# Shared Headers
# =============================================================================

ddk_headers(
    name = "vvcam_headers",
    hdrs = glob(["**/*.h"]),
    includes = [
        ".",
        "common",
        "dwe",
        "isp",
        "v4l2",
        "v4l2/dwe",
        "v4l2/isp",
        "v4l2/video",
    ],
)

# =============================================================================
# Module definitions for each kernel build
# =============================================================================

define_vvcam(
    name_suffix = "imx8mp",
    kernel_build = "//kernel_imx:imx8mp",
    kernel_headers = "//kernel_imx:all_headers_aarch64",
)

define_vvcam(
    name_suffix = "imx",
    kernel_build = "//kernel_imx:imx",
    kernel_headers = "//kernel_imx:all_headers_aarch64",
)

# =============================================================================
# Default aliases (for backward compatibility)
# =============================================================================

alias(
    name = "vvcam_modules",
    actual = ":vvcam_modules_imx8mp",
)

alias(
    name = "vvcam-dwe",
    actual = ":vvcam-dwe_imx8mp",
)

alias(
    name = "vvcam-isp",
    actual = ":vvcam-isp_imx8mp",
)

alias(
    name = "vvcam-video",
    actual = ":vvcam-video_imx8mp",
)

alias(
    name = "os08a20",
    actual = ":os08a20_imx8mp",
)

alias(
    name = "basler-camera-driver-vvcam",
    actual = ":basler-camera-driver-vvcam_imx8mp",
)
