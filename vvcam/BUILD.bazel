#
# Bazel build configuration for Verisilicon ISP VVCAM drivers
#
# Modules built:
#   - vvcam-dwe.ko     (Dewarp Engine)
#   - vvcam-isp.ko     (ISP core)
#   - vvcam-video.ko   (V4L2 video device)
#   - os08a20.ko       (OS08A20 sensor driver)
#   - basler-camera-driver-vvcam.ko (Basler camera proxy)
#
# Usage:
#   //verisilicon_sw_isp_vvcam/vvcam:vvcam_modules_imx8mp
#
# Note: Currently only i.MX 8M Plus has ISP hardware.

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load(":vvcam.bzl", "define_vvcam")

package(default_visibility = ["//visibility:public"])

# =============================================================================
# Shared Headers
# =============================================================================

ddk_headers(
    name = "vvcam_headers",
    hdrs = glob(["**/*.h"]),
    includes = [
        ".",
        "common",
        "dwe",
        "isp",
        "v4l2",
        "v4l2/dwe",
        "v4l2/isp",
        "v4l2/video",
    ],
)

# =============================================================================
# Module definitions (i.MX 8M Plus only - sole platform with ISP)
# =============================================================================

define_vvcam(
    name_suffix = "imx8mp",
    kernel_build = "//kernel_imx:imx8mp",
    kernel_headers = "//kernel_imx:all_headers_aarch64",
)
